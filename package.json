{
  "name": "mycamerascontroller",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:agent": "npm run build -w packages/agent",
    "build:client": "npm run build -w packages/client",
    "dev:agent": "npm run dev -w packages/agent",
    "dev:client": "npm run dev -w packages/client",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w packages/agent && npm run typecheck -w packages/client"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "@types/node": "^22.7.4"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.23.1": true,
    "protobufjs@7.6.6": true
  }
}
