    "dist:linux": "node build.mjs && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@mcc/shared": "*",
    "electron": "^32.1.0",
    "electron-builder": "^25.1.0",
    "esbuild": "^0.23.1"
