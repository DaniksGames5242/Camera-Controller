<?xml version="1.0" encoding="utf-8"?>
<!-- Deep space background with a faint cyan bloom at the top, matching the
     desktop client's holographic backdrop. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="0.15"
                android:centerY="0.05"
                android:startColor="#2635E6FF"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="70%p"
                android:centerX="0.9"
                android:centerY="0.95"
                android:startColor="#1FFF3FA4"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
