<?xml version="1.0" encoding="utf-8"?>
<!-- Holographic panel row: faint cyan wash behind a thin glowing edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#2635E6FF"
                android:endColor="#0835E6FF" />
            <stroke android:width="1dp" android:color="@color/cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#1435E6FF"
                android:endColor="#0435E6FF" />
            <stroke android:width="1dp" android:color="@color/cyan_faint" />
        </shape>
    </item>
</selector>
