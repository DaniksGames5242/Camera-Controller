<?xml version="1.0" encoding="utf-8"?>
<!--
  The stage is a real GL surface behind the whole screen, not a background
  drawable: everything above it is transparent so the room, its dust and its
  optics show through every panel of the interface.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.mycamerascontroller.client.holo.HoloStageView
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <com.mycamerascontroller.client.holo.DecodeTextView
            android:id="@+id/brandMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.16"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.26"
            android:text="@string/brand_sub"
            android:textColor="@color/ink_faint"
            android:textSize="9sp" />

        <com.mycamerascontroller.client.holo.HoloStatsView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.3"
            android:text="@string/section_nodes"
            android:textColor="@color/ink_faint"
            android:textSize="9sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/deviceList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="always"
                android:paddingBottom="24dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <com.mycamerascontroller.client.holo.HoloPulseView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.28"
                    android:text="@string/no_devices"
                    android:textColor="@color/ink_dim"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/no_devices_sub"
                    android:textColor="@color/ink_faint"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <com.mycamerascontroller.client.holo.HoloButtonView
                android:id="@+id/scanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.mycamerascontroller.client.holo.HoloButtonView
                android:id="@+id/recentreButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <View
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.mycamerascontroller.client.holo.HoloButtonView
                android:id="@+id/dedupeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <com.mycamerascontroller.client.holo.HoloRadialMenu
        android:id="@+id/radial"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.mycamerascontroller.client.holo.HoloToastHost
        android:id="@+id/toasts"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.mycamerascontroller.client.holo.HoloBootView
        android:id="@+id/boot"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
