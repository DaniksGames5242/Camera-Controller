<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <EditText
        android:id="@+id/settingsWidth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ширина (px), например 1280"
        android:inputType="number" />

    <EditText
        android:id="@+id/settingsHeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Высота (px), например 720"
        android:inputType="number" />

    <EditText
        android:id="@+id/settingsFps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="FPS, например 30"
        android:inputType="number" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/settings_hint"
        android:textColor="#888888"
        android:textSize="12sp" />

</LinearLayout>
